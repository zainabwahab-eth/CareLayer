{
  "name": "@carelayer/api",
  "version": "0.0.0",
  "private": true,
  "description": "CareLayer backend: Express + TypeScript + PostgreSQL (Prisma). Owned by Zainab.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --env-file-if-exists=.env src/seed/run.ts",
    "db:studio": "prisma studio",
    "testnet:setup": "tsx scripts/testnet-setup.ts",
    "x402:pay": "tsx --env-file-if-exists=.env scripts/pay-x402.ts",
    "test:testnet": "vitest run --config vitest.testnet.config.ts"
  },
  "dependencies": {
    "@carelayer/shared": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@stellar/stellar-sdk": "16.4.1",
    "@x402/core": "2.31.0",
    "@x402/express": "2.31.0",
    "@x402/fetch": "2.31.0",
    "@x402/stellar": "2.31.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
