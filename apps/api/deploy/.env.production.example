# Deployed API (Google Cloud Run + Neon), Z11. Copy to apps/api/deploy/.env.production (gitignored)
# and fill it in. `deploy/cloudrun.sh secrets` uploads the SECRET keys to Google Secret Manager;
# `deploy/cloudrun.sh deploy` sets the others as plain env vars on the service. Never commit the copy.
#
# Treasury, facilitator key (and a test payer): a SEPARATE set from your local .env, generated with
#   CARELAYER_ENV_FILE=deploy/.env.production npm run testnet:setup -w @carelayer/api

NODE_ENV=production
LOG_LEVEL=info
# Hikmah's deployed frontends (women's app, nurse app), comma-separated. Cookies and CORS need them.
CORS_ORIGINS=https://carelayer-web.example,https://carelayer-nurses.example
# Women's app (links in "answer ready" emails) and nurse app (links in alert emails)
WEB_APP_URL=https://carelayer-web.example
NURSE_APP_URL=https://carelayer-nurses.example

# SECRET. Neon: Dashboard > Connect > the DIRECT connection string (not "pooled"), e.g.
#   postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/carelayer?sslmode=require
DATABASE_URL=

ANSWER_PRICE_KOBO=50000
NGN_PER_USDC=1600

# SECRET x3. 48 random bytes each (base64url) / 32 bytes (base64). NEW values, not your local ones:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER change WALLET_ENCRYPTION_KEY once wallets exist.
JWT_ACCESS_SECRET=
AUTH_PEPPER=
WALLET_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
# Production refuses "console" (it would put sign-in codes in logs).
EMAIL_TRANSPORT=resend
# On the domain you verified in Resend, e.g. CareLayer <codes@yourdomain.com>
EMAIL_FROM=
# SECRET. Resend API key (sending access).
EMAIL_API_KEY=
# The frontends are on other domains than the API: the refresh cookie must be SameSite=None; Secure.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# SECRET. Filled by testnet:setup (see top).
STELLAR_TREASURY_SECRET=
X402_NETWORK=stellar:testnet
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# SECRET. Filled by testnet:setup (anonymous key). Before the demo: a non-anonymous key (see TASKS Z11).
X402_FACILITATOR_API_KEY=
# Filled by testnet:setup (the treasury's public key).
X402_PAY_TO_ADDRESS=
X402_TEST_ROUTE=false
# Filled by testnet:setup; NOT deployed (only scripts use it).
X402_TEST_PAYER_SECRET=

# SECRET. Paystack TEST secret key (sk_test_...).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://carelayer-web.example/account/wallet
PAYSTACK_BASE_URL=https://api.paystack.co

LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# SECRET. nvapi-...
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TIMEOUT_MS=45000
