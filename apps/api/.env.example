# apps/api environment. Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development
PORT=4000
# The two frontends (web, workers)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

LOG_LEVEL=info

# Matches docker-compose.yml (local dev only)
DATABASE_URL=postgresql://carelayer:carelayer@localhost:5432/carelayer?schema=public
# `npm test` creates a throwaway database carelayer_<timestamp>_test on this server, migrates it,
# and drops it afterwards. The name here must end in _test; the user needs CREATEDB.
DATABASE_URL_TEST=postgresql://carelayer:carelayer@localhost:5432/carelayer_test?schema=public

# Price of one nurse answer in kobo (₦500)
ANSWER_PRICE_KOBO=50000
# Fixed demo rate: naira per 1 USDC (testnet only, not a market rate). Up to 2 decimals.
NGN_PER_USDC=1600

# Auth (Z3). Two REQUIRED secrets, at least 32 characters each. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# HMAC key for stored sign-in codes and refresh tokens
AUTH_PEPPER=
# Google sign-in (OAuth client ID). Empty = POST /auth/google answers 503.
GOOGLE_CLIENT_ID=
# Sign-in code emails. "console" prints codes in the API log (dev only; refused in production).
# "resend" sends through Resend: needs EMAIL_API_KEY and an EMAIL_FROM on a domain verified in Resend.
EMAIL_TRANSPORT=console
# e.g. CareLayer <codes@your-domain>
EMAIL_FROM=
# Secret. Resend API key (a "sending access" key restricted to the domain is enough)
EMAIL_API_KEY=
# Refresh cookie. Secure defaults to true in production. SameSite=none needs Secure=true.
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=lax

# Stellar (testnet only). `npm run testnet:setup -w @carelayer/api` fills the empty values below
# (treasury + test payer wallets, USDC trustlines, test USDC, facilitator key). It never overwrites.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Secret. Sponsors new user wallets (Z4), receives x402 payments, pays nurses (Z8) and top-ups (Z5).
# Empty = wallets stay "pending" (no on-chain account).
STELLAR_TREASURY_SECRET=
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# REQUIRED. Secret. Encrypts custodial wallet secrets at rest (AES-256-GCM). 32 bytes, base64 or hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER change it once wallets exist: their secrets could no longer be decrypted.
WALLET_ENCRYPTION_KEY=

# x402 on Stellar (official @x402/* packages + OpenZeppelin Channels facilitator, testnet only)
X402_NETWORK=stellar:testnet
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# Secret. Anonymous testnet key from https://channels.openzeppelin.com/testnet/gen
X402_FACILITATOR_API_KEY=
# Treasury public key (G...): where x402 payments go
X402_PAY_TO_ADDRESS=
# Z2 proof route GET /x402-test (0.01 USDC). Never in production.
X402_TEST_ROUTE=false
# Secret. Test agent wallet used by `npm run x402:pay` and `npm run test:testnet`
X402_TEST_PAYER_SECRET=

# Paystack TEST mode only (top-ups, Z5). Your own keys: Paystack dashboard, Test Mode on,
# Settings > API Keys & Webhooks. Live keys (sk_live_) are refused.
# Secret. Empty = POST /topups answers 503.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Where Paystack sends her back after paying (the women's app wallet screen)
PAYSTACK_CALLBACK_URL=http://localhost:5173/account/wallet
PAYSTACK_BASE_URL=https://api.paystack.co

# Assistant LLM (Z6): any OpenAI-compatible chat completions API.
# Default: NVIDIA's free hosted models (build.nvidia.com: open a model, "Get API Key", nvapi-...).
# OpenAI instead: LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=<model id>, your sk-... key.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Secret. Empty = POST /chat and /chat/draft answer 503 (the red-flag list still works).
LLM_API_KEY=
# Chosen in Z6 on the free NVIDIA tier: ~10 s per reply and valid JSON every time (see docs/TASKS.md)
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Per call. Past this she gets a clear "try again".
LLM_TIMEOUT_MS=45000

# Nurse app, linked from "a question is waiting" alert emails
NURSE_APP_URL=http://localhost:5174
