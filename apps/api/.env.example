# apps/api environment. Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development
PORT=4000
# The two frontends (web, workers)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Matches docker-compose.yml (local dev only)
DATABASE_URL=postgresql://carelayer:carelayer@localhost:5432/carelayer?schema=public

# --- Not used by the skeleton yet. Placeholders so the shape is agreed. ---

# Auth
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=
GOOGLE_CLIENT_ID=
# Transactional email for 6-digit codes (provider TBD)
EMAIL_FROM=
EMAIL_API_KEY=

# Stellar (testnet only)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_TREASURY_SECRET=
STELLAR_USDC_ISSUER=
# Encrypts custodial wallet secrets at rest
WALLET_ENCRYPTION_KEY=
# Fixed testnet rate used to show naira
NGN_PER_USDC=

# x402 (check current docs: Coinbase facilitator or OpenZeppelin relayer plugin)
X402_FACILITATOR_URL=
X402_PAY_TO_ADDRESS=
ANSWER_PRICE_KOBO=50000

# Paystack TEST mode only
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# LLM gateway (provider TBD)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
