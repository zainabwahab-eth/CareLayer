# apps/mcp environment. Copy to .env. Never commit real secrets.

# The CareLayer API the MCP server calls (local: http://localhost:4000)
CARELAYER_API_URL=http://localhost:4000
# Secret. Her agent token (starts with clat_): CareLayer app > Account > Use CareLayer in Claude,
# or POST /auth/agent-tokens. stdio mode only (in HTTP mode each request sends its own token).
CARELAYER_AGENT_TOKEN=
# "http" = hosted Streamable HTTP on PORT (/mcp). Empty = stdio (Claude Desktop / Claude Code).
MCP_TRANSPORT=
PORT=8080
