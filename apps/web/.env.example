# Copy to .env.local. Only VITE_* variables reach the browser: never put secrets here.

# apps/api base URL. "/api" = same-origin proxy for phone testing (see README "Testing on phones")
VITE_API_URL=http://localhost:4000
# true = use the mock API (for frontend work before the backend is ready)
VITE_USE_MOCK_API=true
VITE_GOOGLE_CLIENT_ID=

# Health workers' app (apps/workers), linked from the landing page
VITE_WORKERS_APP_URL=http://localhost:5174

# Hosted CareLayer MCP server, shown on Account → Use CareLayer in Claude
VITE_MCP_URL=https://mcp.carelayer.health/mcp
