# Keep the build context small and secret-free.
**/node_modules
**/dist
**/dev-dist
**/coverage
**/.env
**/.env.*
!**/.env.example
apps/api/src/generated
apps/api/evals/reports
# Other workspaces: only their manifests (npm ci checks the lockfile against every workspace).
apps/web/*
!apps/web/package.json
apps/workers/*
!apps/workers/package.json
# apps/mcp: sources are needed for Dockerfile.mcp (its node_modules/dist are excluded above).
.git
docs
*.md
!apps/api/prompts/*.md
