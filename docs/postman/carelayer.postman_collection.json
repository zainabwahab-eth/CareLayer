  "item": [
    {
      "name": "Health",
      "description": "GET /health: 200 when Postgres answers, 503 when it does not (docs/API_CONTRACT.md §1).",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 (or 503 when the database is down)', () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "const body = pm.response.json();",
                  "pm.test('reports the database', () => pm.expect(body.database).to.be.oneOf(['ok', 'down']));",
                  "pm.test('service and contract version', () => {",
                  "  pm.expect(body.service).to.eql('carelayer-api');",
                  "  pm.expect(body.contractVersion).to.eql('v1');",
                  "});",
                  "pm.test('status matches database', () => pm.expect(body.status).to.eql(body.database === 'ok' ? 'ok' : 'unavailable'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Public. Pings Postgres with a 2 s timeout. Cache-Control: no-store."
          },
          "response": [
            {
              "name": "200 database ok",
              "originalRequest": {
                "method": "GET",
